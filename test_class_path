    @Test
    public void testDrawMultipleEllipse() {
        BoxAndWhiskerRenderer renderer = new BoxAndWhiskerRenderer();
        Graphics2D g2 = createMock(Graphics2D.class);
        Point point = new Point(100, 100);
        double boxWidth = 50.0;
        double oRadius = 5.0;
        
        Ellipse2D expectedDot1 = new Ellipse2D.Double(point.getX() - (boxWidth / 2) + oRadius, point.getY(), oRadius, oRadius);
        Ellipse2D expectedDot2 = new Ellipse2D.Double(point.getX() + (boxWidth / 2), point.getY(), oRadius, oRadius);
        
        renderer.drawMultipleEllipse(g2, point, boxWidth, oRadius);
        
        ArgumentCaptor<Shape> shapeCaptor = ArgumentCaptor.forClass(Shape.class);
        verify(g2, times(2)).draw(shapeCaptor.capture());
        
        List<Shape> capturedShapes = shapeCaptor.getAllValues();
        
        assertEquals("Shape 1 matches", expectedDot1, capturedShapes.get(0));
        assertEquals("Shape 2 matches", expectedDot2, capturedShapes.get(1));
    }

